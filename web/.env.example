# Copy to web/.env.local for a local build against a real Firebase project,
# or add these as Environment Variables in Vercel (Production + Preview).
# From Firebase console > Project settings > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
