# Server-side secrets. Set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Whole service-account JSON on one line (Firebase console > Project settings >
# Service accounts > Generate new private key).
FIREBASE_SERVICE_ACCOUNT=

# Random string; Vercel sends it as a bearer token to /api/cron/daily.
CRON_SECRET=

# Optional: Google Places (live pharmacy search, rating and reviews). Without
# it, search falls back to the FDA licensed-pharmacy directory.
GOOGLE_MAPS_API_KEY=

# Optional: AI chat triage (guided questions work without it). Free key, no card:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
