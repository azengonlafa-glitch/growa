{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --omit=dev && npm --prefix web install",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "data/pharmacy-directory-bangkok.json"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 23 * * *"
    }
  ]
}
